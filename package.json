{
  "name": "temp-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tailwindcss -i ./src/style.css -o ./style.css --watch & serve .",
    "build": "mkdir -p dist && cp -r src public index.html dist/ && tailwindcss -i ./src/style.css -o ./dist/style.css --minify"
  },
  "devDependencies": {
    "autoprefixer": "^10.6.2",
    "daisyui": "^4.12.24",
    "postcss": "^8.5.32",
    "serve": "^14.2.6",
    "tailwindcss": "^3.4.19"
  }
}
